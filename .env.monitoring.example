# ─────────────────────────────────────────────────────────────────────────────
# LexBangla — Monitoring & Observability environment variables
# Copy to .env and fill in all required values before running docker compose up.
# Values marked REQUIRED must be set; others have defaults shown.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=lexbangla
POSTGRES_USER=lexbangla
POSTGRES_PASSWORD=REQUIRED_change_me          # REQUIRED

# ── Django ────────────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_ENV=production
APP_VERSION=1.0.0                             # shown in Sentry release tracking

# ── Sentry ────────────────────────────────────────────────────────────────────
# Get your DSN from https://sentry.io → Project Settings → Client Keys
SENTRY_DSN=https://XXXXXXX@oXXXXXXX.ingest.sentry.io/XXXXXXX   # REQUIRED
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_PROFILES_SAMPLE_RATE=0.05

# ── Grafana ───────────────────────────────────────────────────────────────────
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=REQUIRED_change_me          # REQUIRED
GF_ROOT_URL=http://localhost:3000             # change to your public URL
GF_SMTP_ENABLED=false
# Uncomment and fill to enable Grafana email notifications:
# GF_SMTP_HOST=smtp.gmail.com:587
# GF_SMTP_USER=your-gmail@gmail.com
# GF_SMTP_PASSWORD=your-app-password
# GF_SMTP_FROM=grafana@lexbangla.com

# ── Alertmanager ──────────────────────────────────────────────────────────────
# Slack incoming webhook (Settings → Incoming Webhooks in your Slack workspace)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../XXX  # REQUIRED

# Email for alert delivery
ALERTMANAGER_SMTP_HOST=smtp.gmail.com:587
ALERTMANAGER_EMAIL_FROM=alerts@lexbangla.com
ALERTMANAGER_EMAIL_USER=your-gmail@gmail.com
ALERTMANAGER_EMAIL_PASSWORD=your-app-password              # REQUIRED
ALERTMANAGER_ONCALL_EMAIL=oncall@lexbangla.com             # REQUIRED

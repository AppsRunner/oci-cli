# ─── LexBangla Production Environment ────────────────────────────────────────
# Copy to .env.prod and fill in real values. NEVER commit .env.prod to git.

# ── Domain ────────────────────────────────────────────────────────────────────
DOMAIN=legalbd.com
CERTBOT_EMAIL=ops@legalbd.com

# ── GitHub Container Registry ─────────────────────────────────────────────────
GITHUB_ORG=appsrunner
IMAGE_TAG=latest

# ── Django Backend ────────────────────────────────────────────────────────────
DEBUG=False
SECRET_KEY=change-me-to-a-long-random-string-50-chars-minimum
ALLOWED_HOSTS=legalbd.com,www.legalbd.com
DJANGO_SETTINGS_MODULE=lexbangla.settings.production

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
POSTGRES_DB=lexbangla
POSTGRES_USER=lexbangla
POSTGRES_PASSWORD=change-me-strong-db-password
DATABASE_URL=postgresql://lexbangla:change-me-strong-db-password@db:5432/lexbangla

# ── Cache (Redis) ─────────────────────────────────────────────────────────────
REDIS_PASSWORD=change-me-strong-redis-password
REDIS_URL=redis://:change-me-strong-redis-password@redis:6379/0

# ── Celery ────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://:change-me-strong-redis-password@redis:6379/1
CELERY_RESULT_BACKEND=redis://:change-me-strong-redis-password@redis:6379/2

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=change-me-sendgrid-api-key
DEFAULT_FROM_EMAIL=noreply@legalbd.com

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://legalbd.com,https://www.legalbd.com

# ── Security ──────────────────────────────────────────────────────────────────
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=63072000
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
CSRF_TRUSTED_ORIGINS=https://legalbd.com,https://www.legalbd.com

# ── OCI (for deploy scripts) ──────────────────────────────────────────────────
OCI_PROFILE=DEFAULT
SUBNET_OCID=ocid1.subnet.oc1..change-me
ADMIN_CIDR=0.0.0.0/0

# ── Sentry ────────────────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Monitoring (Chapter 11) ───────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-strong-grafana-password
ALERT_EMAIL=ops@legalbd.com
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/change-me

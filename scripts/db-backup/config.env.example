# ============================================================
# LexBangla — DB Backup Configuration Template
# Copy to /etc/lexbangla/db-backup.env and fill in values.
# The file must be chmod 600, owned by the postgres user.
# ============================================================

# ── OCI Object Storage (S3-compatible) ───────────────────────
# Customer Secret Key pair — NOT the OCI API key.
# Create at: OCI Console → Profile → Customer Secret Keys
OCI_NAMESPACE=<your-tenancy-object-storage-namespace>
OCI_REGION=ap-mumbai-1
OCI_BUCKET=lexbangla-db-backups

# S3-compatible credentials for the bucket
AWS_ACCESS_KEY_ID=<customer-secret-key-access-id>
AWS_SECRET_ACCESS_KEY=<customer-secret-key>

# Derived endpoint — override only if using a non-standard region
OCI_S3_ENDPOINT=https://${OCI_NAMESPACE}.compat.objectstorage.${OCI_REGION}.oraclecloud.com

# ── WAL-G ────────────────────────────────────────────────────
WALG_S3_PREFIX=s3://${OCI_BUCKET}/walg
AWS_ENDPOINT=${OCI_S3_ENDPOINT}
AWS_REGION=${OCI_REGION}
AWS_S3_FORCE_PATH_STYLE=true
WALG_COMPRESSION_METHOD=brotli
# Keep 7 base backups; WAL segments between them are also retained
WALG_RETAIN_COUNT=7
# Delta backup chain length before a new full base backup is taken
WALG_DELTA_MAX_STEPS=5

# ── PostgreSQL connection ─────────────────────────────────────
PGHOST=/var/run/postgresql
PGPORT=5432
PGUSER=postgres
# List of databases to snapshot with pg_dump (space-separated).
# Use "__all__" to dump every database via pg_dumpall.
PGDUMP_DATABASES=lexbangla

# ── pg_dump snapshot retention ────────────────────────────────
# Number of days to keep daily pg_dump snapshots in OCI Object Storage.
PGDUMP_RETENTION_DAYS=30

# ── Notifications (optional) ─────────────────────────────────
# POST a JSON payload to this URL on failure (leave blank to disable).
ALERT_WEBHOOK_URL=

# ── Local staging ────────────────────────────────────────────
# Temporary directory used during dump; needs enough space for the DB.
STAGING_DIR=/var/tmp/lexbangla-backup

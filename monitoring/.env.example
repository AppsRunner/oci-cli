# Copy to .env and fill in real values. Never commit .env to version control.

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme_strong_password
GRAFANA_URL=http://localhost:3000

# ── Alertmanager — Email (SMTP) ───────────────────────────────────────────────
ALERTMANAGER_SMTP_HOST=smtp.gmail.com:587
ALERTMANAGER_SMTP_FROM=alerts@lexbangla.com
ALERTMANAGER_SMTP_USER=your-gmail@gmail.com
ALERTMANAGER_SMTP_PASSWORD=your-app-password
ALERTMANAGER_EMAIL_TO=ops@lexbangla.com
ALERTMANAGER_EMAIL_CRITICAL=oncall@lexbangla.com

# ── Alertmanager — Slack ──────────────────────────────────────────────────────
# Create an Incoming Webhook at https://api.slack.com/apps → Your App → Incoming Webhooks
ALERTMANAGER_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXXXXXX/XXXXXXX/XXXXXXX

# ── Sentry ────────────────────────────────────────────────────────────────────
# Create a Django project at https://sentry.io and copy the DSN here.
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.10
SENTRY_PROFILES_SAMPLE_RATE=0.05

# ── Grafana SMTP (for Grafana's own notification channel) ────────────────────
GF_SMTP_ENABLED=true
GF_SMTP_HOST=smtp.gmail.com:587
GF_SMTP_USER=your-gmail@gmail.com
GF_SMTP_PASSWORD=your-app-password
GF_SMTP_FROM_ADDRESS=grafana@lexbangla.com

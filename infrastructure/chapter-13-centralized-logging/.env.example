# Copy to .env and fill in values before starting the logging stack.

# Grafana admin credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme-strong-password

# Domain for Grafana's root URL (used in email links, etc.)
GRAFANA_DOMAIN=monitoring.lexbangla.com

# Django log directory on the host (mounted into Promtail)
DJANGO_LOG_DIR=/var/log/django
